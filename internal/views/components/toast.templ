package components

import (
	"pulseops/internal/telemetry"
)

// ToastOOB merender toast notification yang disisipkan secara OOB ke dalam #toast-container
templ ToastOOB(alert telemetry.AlertNotification) {
	<div id="toast-container" hx-swap-oob="afterbegin">
		<div
			class="pointer-events-auto p-4 rounded-xl bg-surface-800 border border-rose-500/60 text-white shadow-2xl shadow-rose-950/60 flex items-start gap-3 transition-all transform animate-in slide-in-from-right duration-300 border-l-4 border-l-rose-500"
			role="alert"
		>
			<div class="w-8 h-8 rounded-lg bg-rose-500/20 border border-rose-500/40 flex items-center justify-center text-rose-400 font-bold shrink-0 text-sm">
				⚠️
			</div>
			<div class="flex-1 min-w-0">
				<div class="flex items-center justify-between gap-2">
					<h4 class="text-xs font-mono font-bold text-rose-300 tracking-wide uppercase">
						{ alert.Title }
					</h4>
					<span class="text-[10px] font-mono text-slate-400">{ alert.Timestamp }</span>
				</div>
				<p class="text-xs text-slate-200 mt-1 leading-relaxed">
					{ alert.Message }
				</p>
			</div>
			<button
				onclick="this.closest('[role=alert]').remove()"
				class="text-slate-400 hover:text-white text-xs font-mono p-1 rounded hover:bg-surface-700 transition-colors"
				title="Dismiss"
			>
				✕
			</button>
		</div>
	</div>
}
