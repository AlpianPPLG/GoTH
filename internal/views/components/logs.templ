package components

import (
	"pulseops/internal/telemetry"
)

// LogRow merender satu baris audit log dalam tabel
templ LogRow(log telemetry.EventLog) {
	<tr class={ "border-b border-surface-700/40 hover:bg-surface-700/30 transition-colors font-mono text-xs", logRowHighlight(log.Level) }>
		<!-- Timestamp -->
		<td class="py-2 px-4 text-slate-400 whitespace-nowrap">
			{ log.Timestamp }
		</td>
		<!-- Level Badge -->
		<td class="py-2 px-4 whitespace-nowrap">
			<span class={ "px-2 py-0.5 rounded text-[10px] font-bold tracking-wider", logLevelBadgeClass(log.Level) }>
				{ string(log.Level) }
			</span>
		</td>
		<!-- Service Tag -->
		<td class="py-2 px-4 text-slate-300 whitespace-nowrap font-semibold">
			<span class="text-slate-500 mr-1">$</span>{ log.Service }
		</td>
		<!-- Message -->
		<td class={ "py-2 px-4", logMessageClass(log.Level) }>
			if log.IsSpike {
				<span class="mr-1.5">⚡</span>
			}
			{ log.Message }
		</td>
	</tr>
}

// LogTable merender struktur tabel dan baris-baris log awal dengan Search & Filtering
templ LogTable(logs []telemetry.EventLog) {
	<div class="rounded-xl bg-surface-800/90 border border-surface-700/80 shadow-lg overflow-hidden flex flex-col">
		<!-- Table Header / Toolbar -->
		<div class="p-4 border-b border-surface-700/60 flex flex-wrap items-center justify-between gap-3 bg-surface-800">
			<div class="flex items-center gap-3">
				<div class="flex items-center gap-2">
					<span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
					<h2 class="font-mono text-sm font-bold text-white tracking-wide uppercase">Live Event Stream</h2>
				</div>
				<span class="text-xs font-mono text-slate-500">| sse-swap="log-entry"</span>
			</div>

			<!-- Search & Filter Controls via HTMX -->
			<div class="flex items-center gap-2 flex-wrap">
				<!-- Search Input with Debounce -->
				<div class="relative">
					<input
						type="text"
						name="q"
						placeholder="Search logs..."
						hx-get="/api/logs/filter"
						hx-trigger="keyup changed delay:300ms, search"
						hx-target="#log-table-body"
						class="w-44 px-3 py-1 text-xs font-mono rounded-lg bg-surface-900 border border-surface-700 text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500 transition-colors"
					/>
				</div>

				<!-- Quick Filter Pills -->
				<div class="flex items-center rounded-lg bg-surface-900 border border-surface-700 p-0.5 text-[11px] font-mono">
					<button
						hx-get="/api/logs/filter?level=ALL"
						hx-target="#log-table-body"
						class="px-2 py-0.5 rounded text-slate-400 hover:text-white transition-colors"
					>
						ALL
					</button>
					<button
						hx-get="/api/logs/filter?level=WARN"
						hx-target="#log-table-body"
						class="px-2 py-0.5 rounded text-amber-400 hover:bg-amber-950/40 transition-colors"
					>
						WARN
					</button>
					<button
						hx-get="/api/logs/filter?level=CRIT"
						hx-target="#log-table-body"
						class="px-2 py-0.5 rounded text-rose-400 hover:bg-rose-950/40 transition-colors"
					>
						CRIT
					</button>
				</div>

				<!-- Clear Button -->
				<button
					onclick="document.getElementById('log-table-body').innerHTML = ''"
					class="text-xs font-mono px-2.5 py-1 rounded bg-surface-700 hover:bg-surface-600 text-slate-300 border border-surface-600 transition-colors"
					title="Clear buffer"
				>
					Clear
				</button>
			</div>
		</div>

		<!-- Scrollable Table -->
		<div class="overflow-x-auto max-h-[360px] overflow-y-auto">
			<table class="w-full text-left border-collapse">
				<thead class="bg-surface-900/90 sticky top-0 z-10 text-[11px] font-mono text-slate-400 uppercase tracking-wider border-b border-surface-700/60">
					<tr>
						<th class="py-2 px-4">Timestamp</th>
						<th class="py-2 px-4">Level</th>
						<th class="py-2 px-4">Origin</th>
						<th class="py-2 px-4">Event Payload / Message</th>
					</tr>
				</thead>
				<!-- SSE Target: Baris baru disisipkan di atas via hx-swap="afterbegin" -->
				<tbody id="log-table-body" sse-swap="log-entry" hx-swap="afterbegin">
					for _, l := range logs {
						@LogRow(l)
					}
				</tbody>
			</table>
		</div>
	</div>
}

func logLevelBadgeClass(level telemetry.LogLevel) string {
	switch level {
	case telemetry.LevelCritical:
		return "bg-rose-950/80 text-rose-300 border border-rose-500/50"
	case telemetry.LevelWarn:
		return "bg-amber-950/80 text-amber-300 border border-amber-500/50"
	default:
		return "bg-emerald-950/60 text-emerald-300 border border-emerald-500/30"
	}
}

func logRowHighlight(level telemetry.LogLevel) string {
	if level == telemetry.LevelCritical {
		return "bg-rose-950/30 border-l-2 border-l-rose-500"
	}
	return ""
}

func logMessageClass(level telemetry.LogLevel) string {
	switch level {
	case telemetry.LevelCritical:
		return "text-rose-200 font-semibold"
	case telemetry.LevelWarn:
		return "text-amber-200"
	default:
		return "text-slate-300"
	}
}
